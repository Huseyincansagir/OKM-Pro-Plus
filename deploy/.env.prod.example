APP_ENVIRONMENT=Production
APP_IMAGE_REPOSITORY=factory-erp
APP_IMAGE_TAG=local

POSTGRES_DB=factory_erp
POSTGRES_USER=factory_erp_app
POSTGRES_PASSWORD=replace-with-long-random-secret
BACKUP_ROLE=factory_erp_backup
BACKUP_ROLE_PASSWORD=replace-with-separate-backup-role-secret
BACKUP_RETENTION_DAYS=14
RESTORE_ROLE=factory_erp_restore
RESTORE_ROLE_PASSWORD=replace-with-separate-restore-role-secret

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-run

JWT_ISSUER=https://erp.example.local
JWT_AUDIENCE=factory-erp-clients
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

PROXY_HTTP_PORT=8080
DEFAULT_TIMEZONE=Europe/Istanbul
